{
  "name": "mansou",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh -c 'pnpm dev:server & server=$!; sleep 1; pnpm dev:web & web=$!; trap \"kill $server $web 2>/dev/null\" INT TERM EXIT; wait'",
    "dev:server": "pnpm --filter @mansou/server dev",
    "dev:web": "pnpm --filter @mansou/web dev",
    "stop": "sh -c 'pids=$( (lsof -ti tcp:5173; lsof -ti tcp:3210) 2>/dev/null | sort -u); [ -z \"$pids\" ] || kill $pids'",
    "stop:server": "sh -c 'pids=$(lsof -ti tcp:3210 2>/dev/null); [ -z \"$pids\" ] || kill $pids'",
    "stop:web": "sh -c 'pids=$(lsof -ti tcp:5173 2>/dev/null); [ -z \"$pids\" ] || kill $pids'",
    "build": "pnpm -r build",
    "start": "pnpm --filter @mansou/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint \"{apps,packages}/**/src/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:novels": "node scripts/verify-novels.mjs",
    "filter:novels": "node scripts/filter-novel-sources.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@12.3.4"
}
