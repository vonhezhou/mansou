{
  "name": "@venera/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "compat": "tsx src/cli/compat.ts",
    "compat:worker": "tsx src/cli/compat.ts --isolation=worker",
    "openapi": "tsx src/cli/openapi.ts",
    "storage": "tsx src/cli/storage.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@venera/contracts": "workspace:*",
    "@venera/storage": "workspace:*",
    "cheerio": "^1.0.0",
    "cookie": "^2.0.1",
    "fastify": "^5.2.1",
    "sharp": "^0.35.4",
    "tough-cookie": "^5.0.0",
    "undici": "^7.2.3",
    "yazl": "^3.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/yazl": "^3.3.1",
    "tsx": "^4.19.2"
  }
}
