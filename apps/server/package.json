{
  "name": "@mansou/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "compat": "tsx src/cli/compat.ts",
    "openapi": "tsx src/cli/openapi.ts",
    "storage": "tsx src/cli/storage.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "admin": "tsx src/cli/admin.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@node-rs/argon2": "^2.2.1",
    "@mansou/contracts": "workspace:*",
    "@mansou/storage": "workspace:*",
    "cookie": "^2.0.1",
    "fastify": "^5.2.1",
    "undici": "^7.2.3",
    "yazl": "^3.3.1",
    "zod": "^3.24.1",
    "@mansou/core": "workspace:*",
    "@mansou/plugin-runtime": "workspace:*",
    "@mansou/novel-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/yazl": "^3.3.1",
    "tsx": "^4.19.2",
    "sharp": "^0.35.4"
  }
}
